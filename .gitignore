# Real configuration: database credentials, master encryption key, AI API key, cron token.
# Never commit it. Copy config/config.example.php to config/config.php on each environment.
/config/config.php

# NOTE: vendor/ is deliberately committed. IONOS shared hosting may not run Composer, so
# deployment is a plain file copy. Do not add vendor/ to this file.

# Test and tooling artefacts
.phpunit.cache/
.phpunit.result.cache
/coverage/
*.log

# Dev-only static preview pages generated by tools/preview/generate.php
/public/preview/

# Local MariaDB data directory used for offline development
/.local-mariadb/

# Local backups of real configs — never commit. Both hold live credentials
# and encryption keys; config.local.php.bak is the localhost one, kept so the
# offline dev setup can be restored after config.php is switched back.
/config/config.production.php.bak
/config/config.local.php.bak


# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
