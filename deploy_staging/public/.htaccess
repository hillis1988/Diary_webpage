# Document root configuration for the mental health diary.
#
# This file is the server-level half of the transport security rule; the application-level
# half is HttpsRedirectMiddleware. Either alone would be enough on a good day, and the point
# of having both is the bad day: a control panel change can lose this file, and a deployment
# to a server without mod_rewrite can lose the redirect, but health data must never cross a
# plaintext connection either way (Requirement 4.3).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect plaintext HTTP to HTTPS before PHP is reached at all.
    # HTTP:X-Forwarded-Proto covers the IONOS setup where TLS terminates in front of Apache.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Everything that is not a real file or directory is the front controller's problem.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Deny dotfiles: .htaccess itself, .env, .git remnants, editor leftovers. Nothing beginning
# with a dot is ever meant to be served from the document root.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Directory listings would enumerate the assets directory; the front controller decides
# what exists.
Options -Indexes

# The application sets the security headers on every response it produces. Repeating the
# static ones here means a file served directly by Apache (a stylesheet, a script) carries
# them too, and that a PHP failure severe enough to bypass the pipeline still cannot be
# framed or sniffed.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>
